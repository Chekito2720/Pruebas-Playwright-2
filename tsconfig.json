{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "target/tsc"
  },
  "include": ["tests/**/*.ts", "src/**/*.ts", "playwright.config.ts"]
}
